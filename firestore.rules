rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Cloud saves: each player can only touch their own save ----------
    match /saves/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && request.resource.data.keys().size() < 80;   // stop junk-stuffing
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ---------- Leaderboard ----------
    // The game stores one entry per player per language, with the document id "<uid>_en" or "<uid>_fr".
    // (The old rule compared the id to the bare uid, so every write was rejected.)
    match /leaderboard/{entryId} {
      allow read: if true;   // public board

      function ownsEntry() {
        return request.auth != null
            && (entryId == request.auth.uid + '_en' || entryId == request.auth.uid + '_fr');
      }

      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'tag', 'stepsPerSecond', 'score', 'language', 'updatedAt'])
            && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
            && d.tag is string && d.tag.size() == 4
            && d.language in ['en', 'fr']
            && entryId == request.auth.uid + '_' + d.language
            && d.score is int && d.score > 0 && d.score <= 10000
            && d.stepsPerSecond is number && d.stepsPerSecond > 0 && d.stepsPerSecond <= 10
            && d.updatedAt is number;
      }

      allow create: if ownsEntry() && validEntry();

      // a stored score can only go up (ties are decided by steps-per-second in the game code)
      allow update: if ownsEntry() && validEntry()
                    && request.resource.data.score >= resource.data.get('score', 0);

      // players can remove themselves (opt-out); also lets them clear an old pre-language entry named just "<uid>"
      allow delete: if request.auth != null
                    && (ownsEntry() || entryId == request.auth.uid);
    }

    // ---------- Gift codes ----------
    // One document per code (document id = the code). Anyone can read a code if they already know its exact name,
    // but nobody can list them, and only you (in the Firebase console) can create or change them.
    match /giftCodes/{code} {
      allow get: if true;
      allow list, write: if false;
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
